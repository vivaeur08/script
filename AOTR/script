-- ██                       AUTO REFILL                          ██
-- ████████████████████████████████████████████████████████████████

local refillLogCount = 0
local refillNoNeedCount = 0
local isRefilling = false

task.spawn(function()
    logInfo("[AutoRefill] Thread démarré")
    while _G.KYO_RUNNING do
        task.wait(0.4)
        if not Settings.AutoRefill then
            if refillAlertVisible then hideRefillAlert() end
            isRefilling = false
            continue
        end
        if isRefilling then continue end
        pcall(function()
            local s = getStats()
            refillLogCount = refillLogCount + 1
            if refillLogCount % 5 == 0 then
                logDebug(string.format("[AutoRefill] RAW: gasText='%s' gasPercent=%s | bladesText='%s' bladesCount=%s",
                    tostring(s.gasText), tostring(s.gasPercent), tostring(s.bladesText), tostring(s.bladesCount)))
            end
            local bladesEmpty = false
            if s.bladesCount ~= nil and s.bladesCount == 0 then bladesEmpty = true end
            if s.bladesText and (string.find(s.bladesText, "^0 /") or string.find(s.bladesText, "^0/")) then
                bladesEmpty = true
            end
            local gasEmpty = false
            if s.gasText then
                local cleaned = tostring(s.gasText):gsub("%%", ""):gsub("%s+", "")
                local n = tonumber(cleaned)
                if (n ~= nil and n <= 0) or cleaned == "0" then gasEmpty = true end
            end
            if s.gasPercent ~= nil and s.gasPercent <= 0 then gasEmpty = true end
            local needsRefill = bladesEmpty or gasEmpty
            if refillLogCount % 5 == 0 then
                logDebug(string.format("[AutoRefill] EVAL: bladesEmpty=%s gasEmpty=%s → needs=%s",
                    tostring(bladesEmpty), tostring(gasEmpty), tostring(needsRefill)))
            end
            if not needsRefill then
                refillNoNeedCount = refillNoNeedCount + 1
                if refillNoNeedCount >= 6 and refillAlertVisible then hideRefillAlert() end
                return
            end
            refillNoNeedCount = 0
            logInfo("[AutoRefill] ✅ Besoin détecté !")
            isRefilling = true
            task.spawn(function()
                local success = pcall(function()
                    local r = findRefill()
                    if not r then logError("[AutoRefill] findRefill() retourne nil !"); return end
                    local pos = getPlayerPosition()
                    if not pos then logError("[AutoRefill] getPlayerPosition() retourne nil !"); return end
                    showRefillAlert()
                    if not r.Anchored then r.Anchored = true end
                    r.CFrame = CFrame.new(pos)
                    logSuccess(string.format("[AutoRefill] 🚀 TP DONE → Part à %s", tostring(r.Position)))
                    task.wait(0.3)
                    logInfo("[AutoRefill] ⌨️  Appui R")
                    pressKey(Enum.KeyCode.R)
                    task.wait(0.5)
                    logInfo("[AutoRefill] ⌨️  Appui R (confirmation)")
                    pressKey(Enum.KeyCode.R)
                    task.wait(1.5)
                    logSuccess("[AutoRefill] ✅ Cycle terminé")
                end)
                if not success then logError("[AutoRefill] Erreur dans le cycle") end
                isRefilling = false
            end)
        end)
    end
end)

