local function pressKey(keyCode)
    if hasKeypress then
        local ok = pcall(function()
            keypress(keyCode)
            task.wait(0.08)
            keyrelease(keyCode)
        end)
        if ok then return true end
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.08)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
    return true
end

local function getCharacter()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then return nil end
    return chars:FindFirstChild(LocalPlayer.Name)
end

local function getHitbox()
    local c = getCharacter()
    return c and c:FindFirstChild("Hitbox")
end

local function getPlayerPosition()
    local hb = getHitbox()
    if hb then return hb.Position end
    local c = LocalPlayer.Character
    if c and c.PrimaryPart then return c.PrimaryPart.Position end
    if c then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
    end
    return nil
end

local function getPlayerHealth()
    local c = getCharacter()
    if c then
        local hum = c:FindFirstChildOfClass("Humanoid") or c:FindFirstChild("Humanoid")
        if hum then return hum.Health, hum.MaxHealth end
    end
    local c2 = LocalPlayer.Character
    if c2 then
        local hum = c2:FindFirstChildOfClass("Humanoid")
        if hum then return hum.Health, hum.MaxHealth end
    end
    return nil, nil
end

local function getValueFromObject(obj, attrNames)
    if not obj then return nil end
    for _, name in ipairs(attrNames) do
        local v = obj:GetAttribute(name)
        if v ~= nil then return v end
    end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        if obj.Text and obj.Text ~= "" then return obj.Text end
    end
    for _, c in pairs(obj:GetChildren()) do
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            if c.Text and c.Text ~= "" then return c.Text end
        end
    end
    return nil
end

