-- Mouvements humains : A, E, W en AZERTY
local HUMANIZE_KEYS = {
    Enum.KeyCode.A,  -- strafe gauche AZERTY
    Enum.KeyCode.E,  -- strafe droit AZERTY
    Enum.KeyCode.W,  -- avancer
}

local function farmDoHumanizeMove()
    -- Choisir une touche aléatoire parmi A/E/W
    local key = HUMANIZE_KEYS[math.random(#HUMANIZE_KEYS)]
    local holdTime = math.random(8, 20) / 100 -- 0.08s à 0.20s

    pcall(function()
        if hasKeypress then
            keypress(key)
            task.wait(holdTime)
            keyrelease(key)
        else
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(holdTime)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end
    end)
end

local function farmAimAtNape(nape)
    -- Rotation fluide de la caméra vers la nape
    -- AimSmooth : 1 = très lent (lerp 0.05), 10 = quasi instant (lerp 0.5)
    local cam = workspace.CurrentCamera
    local smooth = math.clamp(Settings.FarmAimSmooth, 1, 10)
    local lerpAlpha = smooth * 0.045  -- 1→0.045, 10→0.45

    pcall(function()
        local targetPos = nape.Position
        local camPos = cam.CFrame.Position
        local direction = (targetPos - camPos).Unit
        local targetCF = CFrame.lookAt(camPos, camPos + direction)
        cam.CFrame = cam.CFrame:Lerp(targetCF, lerpAlpha)
    end)
end

local function farmIsAimedAtNape(nape)
    -- Vérifie si la caméra pointe vers la nape (dot product)
    local cam = workspace.CurrentCamera
    local ok = false
    pcall(function()
        local dir = (nape.Position - cam.CFrame.Position).Unit
        local look = cam.CFrame.LookVector
        ok = look:Dot(dir) > 0.82  -- ~34° de tolérance
    end)
    return ok
end

