local trackedTitans = {}

local function isBigTitan(titan)
    local head = titan:FindFirstChild("Head")
    if not head then
        for _, d in pairs(titan:GetDescendants()) do
            if d:IsA("BasePart") and d.Name == "Head" then head = d break end
        end
    end
    if not head or not head:IsA("BasePart") then return false end
    local hs = head.Size
    return hs.X >= BIG_TITAN_HEAD_THRESHOLD.X and hs.Y >= BIG_TITAN_HEAD_THRESHOLD.Y and hs.Z >= BIG_TITAN_HEAD_THRESHOLD.Z
end

local function applyNape(titan)
    pcall(function()
        local hb = titan:FindFirstChild("Hitboxes"); if not hb then return end
        local h = hb:FindFirstChild("Hit"); if not h then return end
        local nape = h:FindFirstChild("Nape"); if not nape then return end
        if Settings.NapeVisible then
            nape.Material = Enum.Material.Neon
            local nc = Settings.NapeColor
            nape.Color = Color3.fromRGB(nc[1], nc[2], nc[3])
        end
        if not Settings.NapeVisible then
            nape.Transparency = 1
        else
            nape.Transparency = (Settings.NapeTransparency or 0) / 100
        end
        if Settings.NapeResize then
            if isBigTitan(titan) then
                nape.Size = NAPE_SIZE_BIG
            else
                local v = Settings.NapeSizeValue
                nape.Size = Vector3.new(v, v * 1.5, v)
            end
        end
    end)
end

local function resetNape(titan)
    pcall(function()
        local hb = titan:FindFirstChild("Hitboxes"); if not hb then return end
        local h = hb:FindFirstChild("Hit"); if not h then return end
        local nape = h:FindFirstChild("Nape"); if not nape then return end
        nape.Transparency = 1
    end)
end

local function createESP(titan)
    if not titan or not titan.Parent or trackedTitans[titan] then return end
    trackedTitans[titan] = true
    local hl = Instance.new("Highlight")
    hl.Name = "Kyo_Highlight"
    hl.FillColor = Color3.fromRGB(138, 43, 226); hl.FillTransparency = 0.8
    hl.OutlineColor = Color3.fromRGB(180, 130, 230); hl.OutlineTransparency = 0.3
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = titan; hl.Parent = titan
    applyNape(titan)
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _G.KYO_RUNNING then conn:Disconnect() return end
        if not titan or not titan.Parent then
            pcall(function() if hl and hl.Parent then hl:Destroy() end end)
            trackedTitans[titan] = nil
            conn:Disconnect()
            return
        end
        hl.Enabled = Settings.ESPEnabled and Settings.HighlightEnabled
        if Settings.ESPEnabled then applyNape(titan) end
    end)
end

local function removeESP(titan)
    pcall(function()
        for _, d in pairs(titan:GetDescendants()) do
            if d:IsA("Highlight") and d.Name == "Kyo_Highlight" then d:Destroy() end
        end
        resetNape(titan)
    end)
    trackedTitans[titan] = nil
end

