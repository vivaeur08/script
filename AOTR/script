local function getRetryButton()
    local interf = LocalPlayer.PlayerGui:FindFirstChild("Interface")
    if not interf then return nil end
    local rewards = interf:FindFirstChild("Rewards"); if not rewards then return nil end
    local main = rewards:FindFirstChild("Main"); if not main then return nil end
    local info = main:FindFirstChild("Info"); if not info then return nil end
    local mainInner = info:FindFirstChild("Main"); if not mainInner then return nil end
    local btns = mainInner:FindFirstChild("Buttons"); if not btns then return nil end
    return btns:FindFirstChild("Retry")
end

