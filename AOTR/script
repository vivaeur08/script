    if farmKillsLabel then
        pcall(function()
            local elapsed = farmSession.active and math.floor(tick() - farmSession.startTime) or 0
            local mins = math.floor(elapsed / 60)
            local secs = elapsed % 60
            farmKillsLabel.Text = string.format(
                "⚔️  Titans tués : %d / %d\n⏱️  Session : %02d:%02d\n🎯  Swings : %d",
                farmSession.titansTues,
                Settings.FarmMaxTitans,
                mins, secs,
                farmSession.swings
            )
        end)
    end
end

