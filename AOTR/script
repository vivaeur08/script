local function findRefill()
    local function safeGet(parent, name)
        if not parent then return nil end
        return parent:FindFirstChild(name)
    end
    local containersToScan = {}
    local u = workspace:FindFirstChild("Unclimbable")
    if u then
        local camps = safeGet(u, "Camps")
        if camps then
            local campSub = safeGet(camps, "Camp")
            if campSub then table.insert(containersToScan, campSub) end
            table.insert(containersToScan, camps)
        end
        local world = safeGet(u, "World")
        if world then
            local buildings = safeGet(world, "Buildings")
            if buildings then
                local hanger = safeGet(buildings, "Hanger")
                if hanger then table.insert(containersToScan, hanger) end
            end
        end
        local props = safeGet(u, "Props")
        if props then
            local hq = safeGet(props, "HQ")
            if hq then
                table.insert(containersToScan, hq)
                local gt = safeGet(hq, "GasTanks")
                if gt then
                    local r = safeGet(gt, "Refill")
                    if r and r:IsA("BasePart") then return r end
                end
            end
        end
        local reloads = safeGet(u, "Reloads")
        if reloads then table.insert(containersToScan, reloads) end
    end
    local c = workspace:FindFirstChild("Climbable")
    if c then
        local utgard = safeGet(c, "Utgard")
        if utgard then table.insert(containersToScan, utgard) end
        local walls = safeGet(c, "_Walls")
        if walls then
            local gate = safeGet(walls, "Gate")
            if gate then table.insert(containersToScan, gate) end
        end
    end
    for _, container in pairs(containersToScan) do
        local direct = safeGet(container, "Refill")
        if direct and direct:IsA("BasePart") then return direct end
        for _, child in pairs(container:GetChildren()) do
            local r1 = safeGet(child, "Refill")
            if r1 and r1:IsA("BasePart") then return r1 end
            local gt = safeGet(child, "GasTanks")
            if gt then
                local r2 = safeGet(gt, "Refill")
                if r2 and r2:IsA("BasePart") then return r2 end
            end
        end
    end
    for _, container in pairs(containersToScan) do
        for _, d in pairs(container:GetDescendants()) do
            if d.Name == "Refill" and d:IsA("BasePart") then return d end
        end
    end
    return nil
end

