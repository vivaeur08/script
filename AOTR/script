local function makeToggle(parent, label, posY, settingKey, callback)
    local d = Settings[settingKey] or false
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -30, 0, 34); row.Position = UDim2.new(0, 15, 0, posY)
    row.BackgroundTransparency = 1
