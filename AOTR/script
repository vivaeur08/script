local function getNearestNape()
    local pos = getPlayerPosition()
    if not pos then return nil, nil, math.huge end

    local nearest, nearestNape, nearestDist = nil, nil, math.huge
    local tf = workspace:FindFirstChild("Titans")
    if not tf then return nil, nil, math.huge end

    for _, titan in pairs(tf:GetChildren()) do
        pcall(function()
            local hb = titan:FindFirstChild("Hitboxes")
            local hit = hb and hb:FindFirstChild("Hit")
            local nape = hit and hit:FindFirstChild("Nape")
            if nape and nape:IsA("BasePart") then
                local d = (nape.Position - pos).Magnitude
                if d < nearestDist and d <= Settings.FarmMaxDistance then
                    nearestDist = d
                    nearest = titan
                    nearestNape = nape
                end
            end
        end)
    end
    return nearest, nearestNape, nearestDist
end

local function farmSendSwing()
