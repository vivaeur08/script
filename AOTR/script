local function destroyAll()
    logInfo("Destruction Kyo...")
    _G.KYO_RUNNING = false
    Settings.AutoFarmEnabled = false
    local tf = workspace:FindFirstChild("Titans")
    if tf then for _, t in pairs(tf:GetChildren()) do removeESP(t) end end
    trackedTitans = {}
    if injConn then injConn:Disconnect() end
    if numConn then numConn:Disconnect() end
    saveSettings()
    local tw = TweenService:Create(MainFrame,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
    tw:Play()
    tw.Completed:Connect(function()
        pcall(function() ScreenGui:Destroy() end)
        pcall(function() MiniGui:Destroy() end)
        pcall(function() CursorGui:Destroy() end)
        pcall(function() AlertsGui:Destroy() end)
        pcall(function() NotifGui:Destroy() end)
        logSuccess("Kyo détruit proprement")
    end)
end

CloseBtn.MouseButton1Click:Connect(destroyAll)
DestroyButton.MouseButton1Click:Connect(destroyAll)

