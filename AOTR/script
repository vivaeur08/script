local NotifGui = Instance.new("ScreenGui")
NotifGui.Name = "Kyo_Notif"; NotifGui.ResetOnSpawn = false
NotifGui.IgnoreGuiInset = true; NotifGui.DisplayOrder = 9997; NotifGui.Parent = CoreGui

local function showNotif(text, color)
    local notif = Instance.new("Frame", NotifGui)
    notif.Size = UDim2.new(0, 340, 0, 50)
    notif.Position = UDim2.new(1, 10, 1, -70)
    notif.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    notif.BorderSizePixel = 0
    local nc = Instance.new("UICorner", notif); nc.CornerRadius = UDim.new(0, 10)
    local ns = Instance.new("UIStroke", notif)
    ns.Color = color or Color3.fromRGB(140, 90, 230); ns.Thickness = 1.5
    local bar = Instance.new("Frame", notif)
    bar.Size = UDim2.new(0, 3, 0.7, 0); bar.Position = UDim2.new(0, 8, 0.15, 0)
    bar.BackgroundColor3 = color or Color3.fromRGB(140, 90, 230); bar.BorderSizePixel = 0
    local bc = Instance.new("UICorner", bar); bc.CornerRadius = UDim.new(1, 0)
    local lbl = Instance.new("TextLabel", notif)
    lbl.Size = UDim2.new(1, -25, 1, 0); lbl.Position = UDim2.new(0, 20, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 230, 245); lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -350, 1, -70)}):Play()
    task.delay(3, function()
        local tw = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            {Position = UDim2.new(1, 10, 1, -70)})
        tw:Play()
        tw.Completed:Connect(function() pcall(function() notif:Destroy() end) end)
    end)
end

