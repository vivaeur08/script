-- ===== SELECT TAB =====
local function selectTab(name)
    HeaderTitle.Text = name
    for n, t in pairs(tabs) do
        local sel = (n == name)
        t.Selected = sel
        t.Accent.Visible = sel
        if sel then
            TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
            t.Button.BackgroundColor3 = Color3.fromRGB(35, 30, 50)
            t.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
            t.Icon.TextColor3 = Color3.fromRGB(140, 90, 230)
        else
            TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            t.Label.TextColor3 = Color3.fromRGB(180, 180, 200)
            t.Icon.TextColor3 = Color3.fromRGB(180, 180, 200)
        end
    end
    for n, p in pairs(pages) do p.Visible = (n == name) end
end
for n, t in pairs(tabs) do
    t.Button.MouseButton1Click:Connect(function() selectTab(n) end)
end
