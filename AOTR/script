-- ██                      AUTO RETRY                            ██
-- ████████████████████████████████████████████████████████████████

local lastRetryClick = 0

local function clickRetry()
    local retry = getRetryButton()
    if not retry or not retry:IsA("GuiObject") then return false end
    if not retry.Visible then return false end
    local ap = retry.AbsolutePosition
    local as = retry.AbsoluteSize
    if as.X < 5 or as.Y < 5 then return false end
    local cx = ap.X + as.X / 2
    local cy = ap.Y + as.Y / 2 + (Settings.RetryOffsetY or 75)
    local vp = workspace.CurrentCamera.ViewportSize
    if cx < 0 or cy < 0 or cx > vp.X or cy > vp.Y then return false end
    pcall(function()
        VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
    logInfo(string.format("AutoRetry: click (%d, %d)", cx, cy))
    return true
end

task.spawn(function()
    while _G.KYO_RUNNING do
        if Settings.AutoRetry then
            pcall(function()
                local h, _ = getPlayerHealth()
                if h and h <= 0 then
                    local retry = getRetryButton()
                    if retry then
                        local now = tick()
                        if now - lastRetryClick > 0.6 then
                            lastRetryClick = now
                            clickRetry()
                        end
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)

