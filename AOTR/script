    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local bg = Instance.new("Frame", row)
    bg.Size = UDim2.new(0, 44, 0, 22); bg.Position = UDim2.new(1, -45, 0.5, -11)
    bg.BackgroundColor3 = d and Color3.fromRGB(120, 80, 220) or Color3.fromRGB(50, 50, 65)
    bg.BorderSizePixel = 0
    local bgc = Instance.new("UICorner", bg); bgc.CornerRadius = UDim.new(1, 0)
    local circle = Instance.new("Frame", bg)
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = d and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255); circle.BorderSizePixel = 0
    local cc = Instance.new("UICorner", circle); cc.CornerRadius = UDim.new(1, 0)
    local clk = Instance.new("TextButton", row)
    clk.Size = UDim2.new(1, 0, 1, 0); clk.BackgroundTransparency = 1; clk.Text = ""
    local function setState(sv, fireCb)
        Settings[settingKey] = sv
        local ti = TweenInfo.new(0.22, Enum.EasingStyle.Quart)
        if sv then
            TweenService:Create(bg, ti, {BackgroundColor3 = Color3.fromRGB(120, 80, 220)}):Play()
            TweenService:Create(circle, ti, {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
        else
            TweenService:Create(bg, ti, {BackgroundColor3 = Color3.fromRGB(50, 50, 65)}):Play()
            TweenService:Create(circle, ti, {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
        end
        if fireCb ~= false and callback then callback(sv) end
        saveSettings()
        logDebug("Toggle [" .. settingKey .. "] = " .. tostring(sv))
    end
    clk.MouseButton1Click:Connect(function() setState(not Settings[settingKey]) end)
    toggleSetters[settingKey] = setState
    return row
end

local function makeSlider(parent, label, posY, minVal, maxVal, settingKey, callback)
    local d = Settings[settingKey] or minVal
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -30, 0, 38); row.Position = UDim2.new(0, 15, 0, posY)
    row.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0, 100, 1, 0); lbl.BackgroundTransparency = 1
    lbl.Text = label; lbl.TextColor3 = Color3.fromRGB(210, 210, 225)
    lbl.TextSize = 13; lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local barBG = Instance.new("Frame", row)
    barBG.Size = UDim2.new(1, -180, 0, 6); barBG.Position = UDim2.new(0, 105, 0.5, -3)
    barBG.BackgroundColor3 = Color3.fromRGB(45, 45, 60); barBG.BorderSizePixel = 0
    local bbc = Instance.new("UICorner", barBG); bbc.CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", barBG)
    local pct = math.clamp((d - minVal) / (maxVal - minVal), 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(140, 90, 230); fill.BorderSizePixel = 0
    local fc = Instance.new("UICorner", fill); fc.CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", barBG)
    knob.Size = UDim2.new(0, 14, 0, 14); knob.Position = UDim2.new(pct, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255); knob.BorderSizePixel = 0; knob.ZIndex = 2
    local kc = Instance.new("UICorner", knob); kc.CornerRadius = UDim.new(1, 0)
    local valBox = Instance.new("TextLabel", row)
    valBox.Size = UDim2.new(0, 55, 0, 26); valBox.Position = UDim2.new(1, -60, 0.5, -13)
    valBox.BackgroundColor3 = Color3.fromRGB(32, 32, 44); valBox.BorderSizePixel = 0
    valBox.Text = tostring(d); valBox.TextColor3 = Color3.fromRGB(230, 230, 245)
    valBox.TextSize = 12; valBox.Font = Enum.Font.GothamMedium
    local vbc = Instance.new("UICorner", valBox); vbc.CornerRadius = UDim.new(0, 6)
    local dragging = false
    local function updFromX(x)
        local rel = math.clamp((x - barBG.AbsolutePosition.X) / barBG.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        valBox.Text = tostring(val)
        Settings[settingKey] = val
        if callback then callback(val) end
    end
    local function startDrag(x) dragging = true; lockDrag(); updFromX(x) end
    barBG.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            startDrag(i.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            startDrag(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then
            dragging = false; unlockDrag(); saveSettings()
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updFromX(i.Position.X)
        end
    end)
end

local function makeColorPicker(parent, label, posY, settingKey, callback)
    local saved = Settings[settingKey] or {255, 0, 0}
    local r, g, b = saved[1], saved[2], saved[3]
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -30, 0, 115); row.Position = UDim2.new(0, 15, 0, posY)
    row.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -60, 0, 22); lbl.BackgroundTransparency = 1
    lbl.Text = label; lbl.TextColor3 = Color3.fromRGB(210, 210, 225)
    lbl.TextSize = 13; lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local preview = Instance.new("Frame", row)
    preview.Size = UDim2.new(0, 40, 0, 22); preview.Position = UDim2.new(1, -45, 0, 0)
    preview.BackgroundColor3 = Color3.fromRGB(r, g, b); preview.BorderSizePixel = 0
    local pc = Instance.new("UICorner", preview); pc.CornerRadius = UDim.new(0, 5)
    local ps = Instance.new("UIStroke", preview)
    ps.Color = Color3.fromRGB(80, 70, 120); ps.Thickness = 1
    local function update()
        local col = Color3.fromRGB(r, g, b)
        preview.BackgroundColor3 = col
        Settings[settingKey] = {r, g, b}
        if callback then callback(col) end
    end
    local function mini(name, posYY, val, color, setter)
        local sr = Instance.new("Frame", row)
        sr.Size = UDim2.new(1, 0, 0, 22); sr.Position = UDim2.new(0, 0, 0, posYY)
        sr.BackgroundTransparency = 1
        local nl = Instance.new("TextLabel", sr)
        nl.Size = UDim2.new(0, 15, 1, 0); nl.BackgroundTransparency = 1
        nl.Text = name; nl.TextColor3 = color; nl.TextSize = 12; nl.Font = Enum.Font.GothamBold
        local bar = Instance.new("Frame", sr)
        bar.Size = UDim2.new(1, -75, 0, 5); bar.Position = UDim2.new(0, 20, 0.5, -2)
        bar.BackgroundColor3 = Color3.fromRGB(45, 45, 60); bar.BorderSizePixel = 0
        local bc = Instance.new("UICorner", bar); bc.CornerRadius = UDim.new(1, 0)
        local fill2 = Instance.new("Frame", bar)
        fill2.Size = UDim2.new(val / 255, 0, 1, 0)
        fill2.BackgroundColor3 = color; fill2.BorderSizePixel = 0
        local fc2 = Instance.new("UICorner", fill2); fc2.CornerRadius = UDim.new(1, 0)
        local vb = Instance.new("TextLabel", sr)
        vb.Size = UDim2.new(0, 45, 1, 0); vb.Position = UDim2.new(1, -50, 0, 0)
        vb.BackgroundTransparency = 1; vb.Text = tostring(val)
        vb.TextColor3 = Color3.fromRGB(210, 210, 225); vb.TextSize = 11; vb.Font = Enum.Font.Gotham
        local dr = false
        local function upd(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(rel * 255)
            fill2.Size = UDim2.new(rel, 0, 1, 0); vb.Text = tostring(v)
            setter(v); update()
        end
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dr = true; lockDrag(); upd(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dr then
                dr = false; unlockDrag(); saveSettings()
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dr and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                upd(i.Position.X)
            end
        end)
    end
    mini("R", 32, r, Color3.fromRGB(255, 80, 80), function(v) r = v end)
    mini("G", 58, g, Color3.fromRGB(80, 255, 100), function(v) g = v end)
    mini("B", 84, b, Color3.fromRGB(80, 130, 255), function(v) b = v end)
end

