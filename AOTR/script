local refillAlertVisible = false
local refillAlertTween = nil

local function showRefillAlert()
    if refillAlertVisible then return end
    refillAlertVisible = true; RefillAlert.Visible = true
    if refillAlertTween then refillAlertTween:Cancel() end
    refillAlertTween = TweenService:Create(RefillAlert,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(0.5, -210, 0, 20)})
    refillAlertTween:Play()
end

local function hideRefillAlert()
    if not refillAlertVisible then return end
    refillAlertVisible = false
