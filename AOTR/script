local function getStats()
    local s = {
        bladesText=nil, bladesCount=nil, bladesMax=nil, bladesOffset=nil,
        gasText=nil, gasPercent=nil, gasOffset=nil
    }
    pcall(function()
        local top7 = LocalPlayer.PlayerGui.Interface.HUD.Main.Top["7"]
        local b = top7:FindFirstChild("Blades")
        if b then
            local sets = b:FindFirstChild("Sets")
            if sets then
                local txt = getValueFromObject(sets, {"Texte","Text","ContentText"})
                if txt then
                    s.bladesText = tostring(txt)
                    local a, c = string.match(tostring(txt), "(%-?%d+)%s*/%s*(%-?%d+)")
                    if a then s.bladesCount = tonumber(a) end
                    if c then s.bladesMax = tonumber(c) end
                end
            end
            local inner = b:FindFirstChild("Inner")
            if inner then
                local bar = inner:FindFirstChild("Bar")
                if bar then
                    local g = bar:FindFirstChild("Gradient")
                    if g and g:IsA("UIGradient") then s.bladesOffset = g.Offset.X end
                end
            end
        end
        local gas = top7:FindFirstChild("Gas")
        if gas then
            local p = gas:FindFirstChild("Percentage")
            if p then
                local txt = getValueFromObject(p, {"ContentText","Texte","Text"})
                if txt then
                    s.gasText = tostring(txt)
                    local n = tonumber(tostring(txt):gsub("%%",""):gsub("%s+",""))
                    if n then s.gasPercent = n end
                end
            end
            local inner = gas:FindFirstChild("Inner")
            if inner then
                local bar = inner:FindFirstChild("Bar")
                if bar then
                    local g = bar:FindFirstChild("Gradient")
                    if g and g:IsA("UIGradient") then s.gasOffset = g.Offset.X end
                end
            end
        end
    end)
    return s
end

